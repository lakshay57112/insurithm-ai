# Required for the API and for the real-model evaluation (never commit the real values).
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional.
# Some newer models ignore or warn about temperature; "none" leaves it out of the request.
# GEMINI_TEMPERATURE=0
# GEMINI_MAX_OUTPUT_TOKENS=8192
# Seconds to wait for one reply (default 120). Raise it if you see ReadTimeout.
# GEMINI_TIMEOUT_SECONDS=120

# Where the API keeps its two SQLite files (case tracker and workflow checkpoints).
# INSURITHM_DATA_DIR=insurithm_data

# Which policy PDFs the policy-library server loads (separated by ":" on Linux/macOS, ";" on Windows)
# and which policy ids it may serve. Defaults: the synthetic demo policy, everything loaded.
# INSURITHM_POLICY_PDFS=
# INSURITHM_ALLOWED_POLICIES=
